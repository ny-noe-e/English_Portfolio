{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "data/posts.json"
    },
    "api/posts/[id].js": {
      "includeFiles": "data/posts.json"
    }
  },
  "rewrites": [
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/posts/:slug", "destination": "/index.html" }
  ]
}
